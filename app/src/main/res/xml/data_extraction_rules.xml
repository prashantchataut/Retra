<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="saves/" />
        <include domain="file" path="cheats/" />
        <include domain="file" path="settings.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <exclude domain="file" path="screens/" />
    </device-transfer>
</data-extraction-rules>
